{
  "name": "@frqncy-network/harness",
  "version": "0.13.4-alpha.1",
  "description": "A plug-and-play LLM harness — provider-indifferent, trace-first, never compacted. Now with ERC-8004 + x402 agent commerce and a Daydreams bridge.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "import": "./dist/trace.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./payments": {
      "types": "./dist/payments/index.d.ts",
      "import": "./dist/payments/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "import": "./dist/wallet/index.js"
    },
    "./bridges": {
      "types": "./dist/bridges/index.d.ts",
      "import": "./dist/bridges/index.js"
    }
  },
  "bin": {
    "frqncy-harness": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENT.md",
    "LICENSE",
    "hermes-skill.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "llm",
    "ai",
    "agent",
    "harness",
    "claude",
    "openai",
    "openrouter",
    "vercel-ai-sdk",
    "frqncy",
    "erc-8004",
    "x402",
    "agent-commerce",
    "agent-payments",
    "trustless-agents"
  ],
  "author": "Orlando Eisenreich <orlando.eisenreich@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0rli-E/frqncy-harness.git"
  },
  "bugs": {
    "url": "https://github.com/0rli-E/frqncy-harness/issues"
  },
  "homepage": "https://github.com/0rli-E/frqncy-harness#readme",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@ai-sdk/perplexity": "^2.0.28",
    "@anthropic-ai/claude-agent-sdk": "^0.1.77",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rollup/rollup-linux-arm64-gnu": "^4.60.2",
    "ai": "^6.0.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@coinbase/cdp-sdk": "^1.0.0",
    "@daydreamsai/core": "*",
    "viem": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    },
    "@coinbase/cdp-sdk": {
      "optional": true
    },
    "@daydreamsai/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.4.0"
  }
}
